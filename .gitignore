# Remove the corrupted .gitignore
rm .gitignore

# Create a clean, working .gitignore
cat > .gitignore << 'EOF'
# Dependencies
node_modules/
*/node_modules/
server/node_modules/
client/node_modules/

# Environment variables
.env
*.env
server/.env
client/.env

# Firebase secrets
service-account.json
*-service-account.json
firebase-admin-sdk.json
firebase-debug.log

# Zone.Identifier files
*.Zone.Identifier

# Build outputs
dist/
build/

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
EOF

# SQLite database files
*.db
*.sqlite
*.sqlite3

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
